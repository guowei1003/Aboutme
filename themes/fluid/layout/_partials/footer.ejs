<% const lab = site.data.lab || {} %>
<div class="footer-inner lab-footer">
  <div class="footer-content lab-footer-content">
    <p class="lab-footer-title">AI芝士知识熟成实验室</p>
    <p class="lab-footer-text"><%= config.description %></p>
    <div class="lab-footer-links">
      <a href="<%= url_for('/categories/芝士力量/') %>"><%= (lab.nav_labels && lab.nav_labels.category) || '观点与方法' %></a>
      <a href="<%= url_for('/archives/') %>">熟成时间线</a>
      <a href="<%= url_for('/evolution/') %>"><%= (lab.nav_labels && lab.nav_labels.evolution) || '进化记录' %></a>
      <a href="<%= url_for('/privacy/') %>"><%= (lab.nav_labels && lab.nav_labels.privacy) || '隐私文档' %></a>
    </div>
  </div>
  <% if (theme.footer.statistics.enable) { %>
    <%- partial('_partials/footer/statistics.ejs') %>
  <% } %>
  <% if(theme.footer.beian.enable) { %>
    <!-- 备案信息 ICP for China -->
    <%- partial('_partials/footer/beian.ejs') %>
  <% } %>
</div>
