<%
const lab = site.data.lab || {}
page.layout = "archive"
page.title = '熟成时间线'
page.subtitle = '按时间回看样本如何形成'
page.banner_img = theme.archive.banner_img
page.banner_img_height = theme.archive.banner_img_height
page.banner_mask_alpha = theme.archive.banner_mask_alpha
page.description = '按时间查看 AI芝士关于 AI 方法论、Agents、部署实践与治理主题的全部文章与样本。'
page.keywords = ['AI 归档', 'AI 时间线', 'Agents 文章', 'AI 方法论', 'AI 治理']
%>

<section class="lab-section lab-listing lab-listing--timeline">
  <div class="lab-section-heading">
    <p class="lab-kicker">档案索引</p>
    <h2>按时间查阅全部归档记录</h2>
    <p><%= lab.archive_intro || '' %></p>
    <div class="lab-meta-row lab-index-state">
      <span class="lab-chip"><%= site.posts.length %> 篇样本</span>
      <span class="lab-chip">时间编目</span>
    </div>
  </div>
  <%- partial('_partials/archive-list.ejs', { params: { key: page.layout, postTotal: site.posts.length } }) %>
</section>
