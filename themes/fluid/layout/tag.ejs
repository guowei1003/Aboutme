<%
const lab = site.data.lab || {}
page.layout = "tag"
page.title = page.tag
page.subtitle = '标签导览'
page.banner_img = theme.tag.banner_img
page.banner_img_height = theme.tag.banner_img_height
page.banner_mask_alpha = theme.tag.banner_mask_alpha
page.description = `查看 AI芝士中与 ${page.tag} 相关的文章、方法与实践样本。`
page.keywords = [page.tag, 'AI芝士', 'AI 文章', 'AI 方法论', 'Agents']

var tag = site.tags.find({name: page.tag}).filter(tag => tag.length).data[0]
%>

<section class="lab-section lab-listing">
  <div class="lab-section-heading">
    <p class="lab-kicker">标签导览</p>
    <h2>#<%= page.tag %></h2>
    <p><%= lab.tag_intro || '' %></p>
    <% if (tag) { %>
      <div class="lab-meta-row">
        <span class="lab-chip"><%= tag.posts.length %> 篇样本</span>
      </div>
    <% } %>
  </div>
  <div class="lab-recent-list">
    <% if (tag) { %>
      <% tag.posts.sort('-date').each(function(post) { %>
        <% const postUrl = url_for(post.path) %>
        <% const excerpt = strip_html(post.description || post.excerpt || post.content || '').substring(0, 150).trim().replace(/\n/g, ' ') %>
        <article class="lab-post-item">
          <div class="lab-post-item-content">
            <div class="lab-post-item-meta">
              <time datetime="<%= full_date(post.date, 'YYYY-MM-DD HH:mm') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
              <span>#<%= page.tag %></span>
            </div>
            <h3><a href="<%= postUrl %>"><%= post.title %></a></h3>
            <p><%= excerpt %></p>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
